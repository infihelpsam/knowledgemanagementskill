DATABASE_URL=postgresql://knowledge:replace-with-random-password@postgres:5432/knowledge
POSTGRES_PASSWORD=replace-with-random-password
REDIS_URL=redis://redis:6379/0
# JSON mapping sha256(bearer token) -> trusted identity. Empty map denies all requests.
AUTH_TOKENS={}
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
MAX_FILE_BYTES=10000000
MAX_TEXT_CHARS=2000000
CHUNK_CHARS=1600
CHUNK_OVERLAP=200
MINIMUM_EVIDENCE=0.2
# 0 disables expiry. Worker hard-deletes documents older than updated_at, hourly.
RETENTION_DAYS=0
JOB_ATTEMPTS=3
